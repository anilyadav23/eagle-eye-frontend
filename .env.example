# Backend API Base URL (leave blank in local development to use Vite proxy, or specify deployed backend URL)
# Example: https://eagle-eye-backend.onrender.com
VITE_API_BASE_URL=

# WebSocket URL (leave blank in local development to use Vite proxy, or specify deployed backend WS URL)
# Example: wss://eagle-eye-backend.onrender.com/ws
VITE_WS_URL=
